{
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "npx prettier --write \"packages/**/*.{js,ts,vue,css,md}\"",
    "core:build": "pnpm run --filter @qyani/core build",
    "components:build": "pnpm run core:build && pnpm run --filter qyani-components build",
    "release": "pnpm run components:build && pnpm publish -r --access public",
    "dev": "pnpm run docs:dev",
    "docs:dev": "pnpm run --filter @qyani-components/docs dev",
    "docs:update": "pnpm run --filter @qyani-components/docs update",
    "docs:build": "pnpm run core:build && pnpm run --filter qyani-components build && pnpm run --filter @qyani-components/docs build",
    "prepare": "husky install "
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@qyani/eslint-config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "*.{js,ts,vue,tsx,jsx}": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{css,md,svg,less,scss}": [
      "prettier --write"
    ],
    "*.{json,lock,yaml,yml}": [
      "prettier --write"
    ],
    "*.{xml,html}": [
      "prettier --write"
    ]
  }
}
