{
  "name": "@qyani/core",
  "version": "1.0.0",
  "description": "Framework-agnostic utilities and data structures for qyani packages",
  "main": "dist/qyani-core.cjs.js",
  "module": "dist/qyani-core.es.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "type-check": "pnpm exec tsc --noEmit",
    "type-check:test": "pnpm exec tsc --project tsconfig.test.json",
    "build": "pnpm vite build && pnpm exec tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/qyani-core.es.js",
      "require": "./dist/qyani-core.cjs.js"
    },
    "./algorithm": {
      "types": "./dist/types/algorithm/index.d.ts",
      "import": "./dist/qyani-core.es.js",
      "require": "./dist/qyani-core.cjs.js"
    },
    "./business": {
      "types": "./dist/types/business/index.d.ts",
      "import": "./dist/qyani-core.es.js",
      "require": "./dist/qyani-core.cjs.js"
    },
    "./types": {
      "types": "./dist/types/types/index.d.ts"
    }
  }
}
