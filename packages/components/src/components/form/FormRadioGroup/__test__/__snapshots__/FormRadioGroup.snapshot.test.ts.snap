  <div class="inner-container"><label for="male" class="container-center"><input checked="" id="male" name="gender" required="" type="radio" value="male"><span class="text-085rem margin-fourth-horizontal">男</span></label><label for="female" class="container-center"><input id="female" name="gender" required="" type="radio" value="female"><span class="text-085rem margin-fourth-horizontal">女</span></label></div>
</div>"
