{
  "name": "@qianrenni/mcp",
  "version": "1.0.0",
  "description": "Knowledge-base MCP server for qyani-components & @qianrenni/core — search docs and API on demand",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qyani-knowledge-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:index": "node dist/build-index.js",
    "start": "node dist/index.js",
    "selftest": "node dist/index.js --selftest",
    "verify": "node scripts/_verify.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "pnpm run build && pnpm run build:index"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3"
  }
}
